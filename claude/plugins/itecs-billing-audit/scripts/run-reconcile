#!/usr/bin/env bash
set -euo pipefail
ITECS_PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=runtime.sh
source "$ITECS_PLUGIN_DIR/scripts/runtime.sh"
itecs_platform
if [[ "${1:-}" != -h && "${1:-}" != --help ]]; then export ITECS_RUNTIME_OFFLINE=1; fi
binary="$(itecs_binary "bin/$ITECS_PLATFORM/billing-reconcile$ITECS_SUFFIX")"
exec "$binary" -reports-dir "$PWD/reports" "$@"
