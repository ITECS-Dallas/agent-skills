#!/usr/bin/env bash
set -euo pipefail
ITECS_PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=runtime.sh
source "$ITECS_PLUGIN_DIR/scripts/runtime.sh"
itecs_platform
itecs_config vcenter VCENTER_MCP_CONFIG
if [[ ! -f "$ITECS_CONFIG" ]]; then
  printf 'vCenter MCP config not found at %s\n' "$ITECS_CONFIG" >&2
  exit 2
fi
exec "$ITECS_PLUGIN_DIR/bin/vcenter-mcp-$ITECS_PLATFORM$ITECS_SUFFIX" -config "$ITECS_CONFIG" "$@"
